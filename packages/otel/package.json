{
  "name": "@77systems/receipts-otel",
  "version": "0.3.0",
  "type": "module",
  "license": "MIT",
  "description": "Opt-in OpenTelemetry instrumentation for Receipts verification.",
  "keywords": [
    "receipts",
    "verification",
    "ai-agents",
    "agent-safety",
    "idempotency",
    "audit-log",
    "hash-chain",
    "mcp",
    "opentelemetry",
    "observability",
    "tracing"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@77systems/receipts-core": "0.3.0",
    "@77systems/receipts-sdk": "0.3.0",
    "@opentelemetry/api": "^1.9.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/77systems-ai/receipts.git",
    "directory": "packages/otel"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-base": "^2.11.0"
  }
}
