{
  "name": "@77systems/receipts-core",
  "version": "0.3.0",
  "description": "Destination verification and append-only receipts for every AI agent.",
  "keywords": [
    "receipts",
    "verification",
    "ai-agents",
    "agent-safety",
    "idempotency",
    "audit-log",
    "hash-chain",
    "mcp",
    "destination-verification",
    "retry-safety",
    "append-only"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/77systems-ai/receipts.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/77systems-ai/receipts#readme",
  "bugs": {
    "url": "https://github.com/77systems-ai/receipts/issues"
  }
}
