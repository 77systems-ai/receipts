{
  "name": "@77systems/receipts-proof",
  "version": "0.3.0",
  "type": "module",
  "license": "MIT",
  "description": "Opt-in local Ed25519 signed Receipts proofs and offline badges.",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@77systems/receipts-core": "0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/77systems-ai/receipts.git",
    "directory": "packages/proof"
  }
}
